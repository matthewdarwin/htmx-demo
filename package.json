{
  "name": "htmx-demo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run spellcheck && npm run format:check && npm run lint && vite build",
    "preview": "vite preview",
    "spellcheck": "cspell \"**/*.html\" \"src/**/*.{js,css}\" \"vite.config.js\" \"*.md\" --no-progress",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint ."
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.1",
    "bulma": "^1.0.4",
    "htmx.org": "^2.0.10",
    "maplibre-gl": "^6.3.0",
    "swiper": "^12.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "cspell": "^10.0.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "vite": "^8.2.0"
  }
}
